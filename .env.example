# NEXUS LLM provider
# Default: local Ollama
NEXUS_PROVIDER=ollama
NEXUS_BASE_URL=http://127.0.0.1:11434
NEXUS_MODEL=qwen3:8b

# OpenAI-compatible local servers (vLLM / llama.cpp / LM Studio):
# NEXUS_PROVIDER=vllm
# NEXUS_BASE_URL=http://127.0.0.1:8000/v1
# NEXUS_MODEL=Qwen/Qwen3-8B

# Optional for authenticated/OpenAI-compatible endpoints
# NEXUS_API_KEY=

# Generation
NEXUS_TEMPERATURE=0.7
NEXUS_MAX_TOKENS=2048
NEXUS_LLM_TIMEOUT=180

# Optional: completely replace the NEXUS system prompt.
# NEXUS_SYSTEM_PROMPT=Você é o NEXUS. Responda de forma direta e neutra.
